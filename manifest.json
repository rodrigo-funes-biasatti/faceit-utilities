{
  "manifest_version": 3,
  "name": "FACEIT Utilities",
  "version": "1.6.0",
  "description": "Muestra utilidades de CS2 (smokes, flashes, molotovs) desde csnades.gg durante partidas de FACEIT",

  "permissions": ["storage", "activeTab", "alarms"],

  "host_permissions": [
    "https://www.faceit.com/*",
    "https://csnades.gg/*",
    "https://assets.csnades.gg/*"
  ],

  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://www.faceit.com/*"],
      "js": ["src/content/content.js"],
      "css": ["src/ui/panel.css"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["icons/*", "icons/grenades/*", "icons/maps/*"],
      "matches": ["https://www.faceit.com/*"]
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "FACEIT Utilities",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
