{
  "manifest_version": 3,
  "name": "FACEIT Utilities",
  "version": "1.0.0",
  "description": "Muestra utilidades de CS2 (smokes, flashes, molotovs) desde csnades.gg durante partidas de FACEIT",

  "permissions": ["storage", "tabs"],

  "host_permissions": [
    "https://*.faceit.com/*",
    "https://csnades.gg/*",
    "https://open.faceit.com/*"
  ],

  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://www.faceit.com/*"],
      "js": ["src/content/content.js"],
      "css": ["src/ui/panel.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "FACEIT Utilities"
  }
}
